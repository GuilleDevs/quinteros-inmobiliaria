# Carpeta de fotos subidas por el panel.
#
# El servidor ya re-codifica cada imagen antes de guardarla y le pone un
# nombre generado, así que acá no debería poder llegar nunca un archivo
# ejecutable. Esto es una segunda barrera por las dudas: aunque alguien
# lograra depositar un .php acá, el servidor se niega a servirlo.

<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|sh|shtml|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
    RemoveType .php .phtml .phar
</IfModule>

# Las fotos no cambian una vez subidas (cada una tiene nombre único),
# así que se pueden cachear agresivamente.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
</IfModule>
