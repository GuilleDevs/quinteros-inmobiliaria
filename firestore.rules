rules_version = '2';

/* ============================================================
   REGLAS DE FIRESTORE
   ------------------------------------------------------------
   Acá está toda la seguridad de la base. Las claves del archivo
   firebase-config.js son públicas por diseño: cualquiera puede
   verlas. Lo que impide que un extraño escriba en la base son
   estas reglas, que se aplican del lado de Google.

   Criterio: la base es privada. El sitio público NO lee de acá,
   lee el archivo JSON que publica el panel en Cloud Storage.
   Por eso ni siquiera hace falta permitir lectura anónima.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      // Una sola cuenta, la de la inmobiliaria. Cualquier usuario
      // autenticado de este proyecto puede administrar el catálogo:
      // no se crean cuentas desde el sitio, solo desde la consola.
      return request.auth != null;
    }

    match /propiedades/{id} {
      allow read, write: if esAdmin();
    }

    // Todo lo que no esté declarado arriba queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
