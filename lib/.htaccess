# Esta carpeta tiene las credenciales de la base de datos.
# Nadie debe poder abrirla desde el navegador: PHP la usa por ruta interna,
# que no pasa por el servidor web.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
