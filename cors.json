[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE"],
    "responseHeader": [
      "Content-Type",
      "Content-Length",
      "Content-Range",
      "Content-Encoding",
      "Content-Disposition",
      "Cache-Control",
      "Authorization",
      "X-Goog-Upload-Protocol",
      "X-Goog-Upload-Status",
      "X-Goog-Upload-URL",
      "x-goog-meta-*",
      "X-Firebase-Storage-Version"
    ],
    "maxAgeSeconds": 3600
  }
]
