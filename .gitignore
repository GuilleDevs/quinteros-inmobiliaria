# ============================================================
#  NO SUBIR AL REPOSITORIO
# ============================================================

# --- Firebase --------------------------------------------------------
# Las claves de assets/js/firebase-config.js NO van acá: son públicas
# por diseño (viajan al navegador de cualquier visitante) y lo que
# protege los datos son firestore.rules y storage.rules.
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
*-debug.log

# --- Fotos subidas desde el panel ------------------------------------
# Ahora viven en Cloud Storage, no en el repositorio. Esta carpeta queda
# solo por compatibilidad con la versión anterior (etiqueta v1-php).
assets/img/propiedades/*
!assets/img/propiedades/LEEME.txt

# --- Sistema operativo -----------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# --- Editores y herramientas locales ---------------------------------
.vscode/
.idea/
.claude/
*.swp
*.sublime-workspace

# --- Varios ----------------------------------------------------------
node_modules/
*.log
*.bak
*.tmp
_mock-*.html
_prueba-*.html
